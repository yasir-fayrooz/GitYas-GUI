# Copy to scripts/release/release.env (git-ignored) and fill in, for building releases on your own machine. Sourced
# by scripts/release/release.sh and publish-github.sh; see docs/releasing.md for where each value comes from. The
# release workflow (.github/workflows/release.yml) sets the same names from repository secrets and variables instead.
# Paths may be Windows paths in Git Bash form (/c/Users/...).

# ---- Releases and updater (required). The repository and public key are compiled into the app: keep them stable.
# The app checks https://github.com/<RELEASE_REPO>/releases/latest/download/latest.json for updates.
RELEASE_REPO=yasir-fayrooz/GitYas-GUI
UPDATE_PUBKEY=
UPDATE_PRIVATE_KEY_PATH=$HOME/.gityas-keys/update.key
UPDATE_PRIVATE_KEY_PASSWORD=

# ---- Windows Authenticode (optional; unsigned without both). A certificate in CurrentUser\My, or a sign command
# with %1 for the file.
WINDOWS_CERTIFICATE_THUMBPRINT=
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
WINDOWS_SIGN_COMMAND=

# ---- macOS (SDKROOT required for the macOS builds; signing optional, ad hoc without it).
SDKROOT=$HOME/sdks/MacOSX14.5.sdk
APPLE_P12_PATH=
APPLE_P12_PASSWORD=
# e.g. $HOME/.gityas-keys/app-store-connect.json; set with APPLE_P12_PATH to notarize.
APPLE_API_KEY_JSON=

# ---- Linux: gensquashfs (squashfs-tools-ng), if it is not on PATH.
GENSQUASHFS=
