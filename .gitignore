# Logs
logs
*.log

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# Rust workspace
/target
# Release builds (scripts/release/release.sh) and their local configuration with key paths and passwords
/dist
/scripts/release/release.env
/src-frontend/Cargo.toml.release-backup
